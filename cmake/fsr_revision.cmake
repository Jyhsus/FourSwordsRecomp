# Writes the build's identity to OUT (a C header), rewriting it only when it
# changes. Run on every build by the fsr_revision target (CMakeLists.txt), so
# an executable always names the commit it was built from:
#   FSR_GIT_COMMIT       this repository's HEAD (40 hex digits, or "unknown")
#   FSR_GIT_DIRTY        1 if tracked files differ from HEAD (the gbarecomp
#                        submodule is reported separately, below)
#   FSR_ENGINE_COMMIT    the gbarecomp submodule's HEAD
#   FSR_ENGINE_PATCHES   SHA-1 of `git diff` in gbarecomp without the BIOS
#                        output: the local patches the engine was built with
# Inputs: SRC (repository root), OUT.

find_package(Git QUIET)

function(fsr_git out_var dir)
    if(NOT GIT_FOUND)
        set(${out_var} "" PARENT_SCOPE)
        return()
    endif()
    execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${dir}" ${ARGN}
                    OUTPUT_VARIABLE value RESULT_VARIABLE result
                    ERROR_QUIET OUTPUT_STRIP_TRAILING_WHITESPACE)
    if(NOT result EQUAL 0)
        set(value "")
    endif()
    set(${out_var} "${value}" PARENT_SCOPE)
endfunction()

fsr_git(commit "${SRC}" rev-parse HEAD)
if(commit STREQUAL "")
    set(commit "unknown")
endif()
fsr_git(changes "${SRC}" status --porcelain --untracked-files=no --ignore-submodules=all)
if(changes STREQUAL "")
    set(dirty 0)
else()
    set(dirty 1)
endif()
fsr_git(engine "${SRC}/gbarecomp" rev-parse HEAD)
if(engine STREQUAL "")
    set(engine "unknown")
endif()
# The BIOS step rewrites a tracked file in the submodule on every machine
# (CLAUDE.md); leave it out so the fingerprint names only the patches.
fsr_git(engine_diff "${SRC}/gbarecomp" diff -- . ":(exclude)src/runtime/generated_bios")
string(REPLACE "\r" "" engine_diff "${engine_diff}")
string(SHA1 patches "${engine_diff}")

set(text "#pragma once\n// Generated by cmake/fsr_revision.cmake on every build. Do not edit.\n")
string(APPEND text "#define FSR_GIT_COMMIT \"${commit}\"\n")
string(APPEND text "#define FSR_GIT_DIRTY ${dirty}\n")
string(APPEND text "#define FSR_ENGINE_COMMIT \"${engine}\"\n")
string(APPEND text "#define FSR_ENGINE_PATCHES \"${patches}\"\n")

set(old "")
if(EXISTS "${OUT}")
    file(READ "${OUT}" old)
endif()
if(NOT old STREQUAL text)
    file(WRITE "${OUT}" "${text}")
endif()
